# Copy to .env.local for local development. Set separately in Vercel.
# Use your actual production domain in Vercel (no trailing path).
NEXTAUTH_URL=http://127.0.0.1:3000
# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET=
# Run npm run admin:setup to generate these locally.
ADMIN_USERNAME=
# scrypt hash only; never put the plaintext password here.
ADMIN_PASSWORD_HASH=

# Shared anonymous comments (server-only Supabase secret key; never NEXT_PUBLIC_).
# Run supabase/comments.sql before enabling these in Vercel.
SUPABASE_URL=
SUPABASE_SECRET_KEY=
# Generate independently with: openssl rand -base64 32
COMMENT_RATE_SECRET=
